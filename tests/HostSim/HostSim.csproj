<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>HostSim</AssemblyName>
    <RootNamespace>HostSim</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\TbtHttpBridge\TbtHttpBridge.csproj" />
  </ItemGroup>

  <!-- 夹具扮演宿主，所以它需要契约副本（与插件不同：插件绝不打包契约）。 -->
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)..\..\lib\ThinkBookToolkit.PluginApi.dll')">
    <Reference Include="ThinkBookToolkit.PluginApi">
      <HintPath>..\..\lib\ThinkBookToolkit.PluginApi.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup Condition="!Exists('$(MSBuildThisFileDirectory)..\..\lib\ThinkBookToolkit.PluginApi.dll')">
    <ProjectReference Include="..\..\third_party\PluginApi\ThinkBookToolkit.PluginApi.csproj">
      <Private>true</Private>
    </ProjectReference>
  </ItemGroup>

</Project>
