<Project Sdk="Microsoft.NET.Sdk">

  <!--
    上游 ThinkBookToolkit 的插件契约（MPL-2.0）。只用于编译期：
    运行时宿主会提供同名同版本（ThinkBookToolkit.PluginApi, Version=1.0.0.0）程序集，
    插件包内绝不包含本程序集。详见 docs/provenance.md。
  -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ThinkBookToolkit.PluginApi</AssemblyName>
    <RootNamespace>ThinkBookToolkit.PluginApi</RootNamespace>
    <VersionPrefix>1.0.0</VersionPrefix>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

</Project>
